SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional for local HS256 JWT verification. Do not expose this value to the frontend.
SUPABASE_JWT_SECRET=
# Server-side scheduled runner only. Never expose this value to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional comma-separated override. Defaults to the existing demo universe.
FORWARD_VALIDATION_UNIVERSE=
# Enforce active private_beta_memberships for authenticated production routes.
PRIVATE_BETA_ENFORCED=false
# Frontend origin used to build one-time private invite URLs.
FRONTEND_APP_URL=http://127.0.0.1:5173
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Day Trading Lab: server-side only. Never expose Alpaca credentials to Vite.
ALPACA_API_KEY_ID=
ALPACA_SECRET_KEY=
# iex is the development feed and has partial US-market coverage. Set sip only
# when the Alpaca subscription supports it; strategy code does not depend on it.
ALPACA_DATA_FEED=iex
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# External Alpaca paper-order routing stays off by default. The lab simulator
# remains paper-only regardless of this setting.
ALPACA_PAPER_API_ENABLED=false
DAY_TRADING_STREAM_ENABLED=false
DAY_TRADING_SYMBOLS=AAPL,MSFT,NVDA
DAY_TRADING_QUOTE_STALE_SECONDS=15
DAY_TRADING_HEARTBEAT_TIMEOUT_SECONDS=30
DAY_TRADING_MAX_SPREAD_PERCENT=0.25
DAY_TRADING_PAPER_BALANCE=100000
# Emergency switch defaults to disabled and must be explicitly enabled locally.
DAY_TRADING_PAPER_ORDERS_ENABLED=false
DAY_TRADING_RECORDING_PATH=data/day_trading_recordings
DAY_TRADING_RESEARCH_ENABLED=false
